# GEMINI_API_KEY: נדרש רק לניתוחי ה-AI בשרת.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APIFY_TOKEN: שאיבת יד2 / יד1 / מדלן דרך שרתי Apify.
# מפיקים ב-https://console.apify.com/settings/integrations
APIFY_TOKEN="MY_APIFY_TOKEN"

# APP_URL: הכתובת שבה מתארח השרת.
APP_URL="MY_APP_URL"

# VITE_API_URL: כתובת השרת שהאתר הסטטי פונה אליה (GitHub Pages).
# ריק = אותו מקור (פיתוח מקומי). לדוגמה: https://nadlan-360-api.onrender.com
VITE_API_URL=""

# אחסון מתמיד למאגר השמור (ריפו GitHub פרטי).
# הטוקן: https://github.com/settings/tokens  — הרשאת repo בלבד.
GITHUB_CACHE_TOKEN=""
GITHUB_CACHE_REPO="chananeltz/nadlan-360-cache"
